{
  "name": "mc-ai-coding-assistant-tool",
  "version": "0.1.0",
  "description": "MC AI Coding Assistant Tool — 本地 stdio MCP（Forge/Fabric/NeoForge）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mc-skill": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "build:vanilla-registries": "npm run build && node scripts/build-vanilla-registries.mjs",
    "fetch:vanilla-registries": "npm run build && node scripts/fetch-vanilla-registries.mjs",
    "test": "npm run build && node test-core.mjs && node test-scripts.mjs && node test-audit-data.mjs && node test-wave-bcd.mjs && node test-cli.mjs && node --test scripts/_lib/pipeline-helpers.test.mjs scripts/_lib/build-yarn-mappings.test.mjs scripts/_lib/build-yarn-sqlite.test.mjs scripts/_lib/parse-tiny.test.mjs scripts/_lib/import-legacy.test.mjs scripts/_lib/ac-cross-gethealth.test.mjs && node test-mcp.mjs && node scripts/assert-no-yarn-json-slurp.mjs",
    "test:core": "npm run build && node test-core.mjs",
    "test:cli": "npm run build && node test-cli.mjs",
    "test:scripts": "node test-scripts.mjs",
    "test:audit": "node test-audit-data.mjs",
    "audit:data": "node scripts/audit-data-consistency.mjs",
    "audit:data:forge": "node scripts/audit-data-consistency.mjs --platform=forge",
    "audit:data:fabric": "node scripts/audit-data-consistency.mjs --platform=fabric",
    "audit:data:neoforge": "node scripts/audit-data-consistency.mjs --platform=neoforge",
    "audit:data:fail-on-error": "node scripts/audit-data-consistency.mjs --platform=all",
    "build:yarn-sqlite": "node scripts/_lib/build-yarn-sqlite.mjs --all",
    "assert:no-yarn-slurp": "node scripts/assert-no-yarn-json-slurp.mjs",
    "smoke:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
