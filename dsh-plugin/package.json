{
  "name": "dsh-mc-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MC AI Coding Assistant 的 DSH 原生插件：按当前模组工程自动定档，只挂该档 skill，并把该档底座规则（00/01/09）注入 system prompt。只读知识库仓库，不写盘、不跑 Gradle。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "minecraft",
    "modding",
    "forge",
    "fabric",
    "neoforge"
  ],
  "engines": {
    "dsh": "^0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "SEE LICENSE IN ../LICENSE"
}
