## 示例：消息类

```java
// messages/MyMessage.java
package com.example.examplemod.messages;

import net.minecraft.network.FriendlyByteBuf;
import net.minecraft.resources.ResourceLocation;

public class MyMessage {
    private int value;
    private ResourceLocation targetId;

    public MyMessage(int value, ResourceLocation targetId) {
        this.value = value;
        this.targetId = targetId;
    }

    public MyMessage(FriendlyByteBuf buf) {
        this.value = buf.readInt();
        this.targetId = buf.readResourceLocation();
    }

    public void encode(FriendlyByteBuf buf) {
        buf.writeInt(value);
        buf.writeResourceLocation(targetId);
    }
}
```

## 示例：注册（通道 + 消息 + 处理器）

```java
// network/ModNetwork.java
package com.example.examplemod.network;

import com.example.examplemod.ExampleMod;
import com.example.examplemod.messages.MyMessage;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.server.level.ServerPlayer;
import net.minecraftforge.event.network.CustomPayloadEvent;
import net.minecraftforge.network.ChannelBuilder;
import net.minecraftforge.network.SimpleChannel;

public final class ModNetwork {
    private static final int PROTOCOL_VERSION = 1;

    public static final SimpleChannel CHANNEL = ChannelBuilder
        .named(new ResourceLocation(ExampleMod.MOD_ID, "main"))
        .networkProtocolVersion(PROTOCOL_VERSION)
        .simpleChannel();

    private ModNetwork() {}

    // 在 FMLCommonSetupEvent 里调用
    public static void register() {
        CHANNEL.messageBuilder(MyMessage.class)
            .encoder(MyMessage::encode)      // BiConsumer<MyMessage, FriendlyByteBuf>
            .decoder(MyMessage::new)         // Function<FriendlyByteBuf, MyMessage>
            .consumerMainThread(ModNetwork::handle)  // 回调在主线程执行
            .add();
    }

    // 处理器签名：static void handle(MSG, CustomPayloadEvent.Context)
    private static void handle(MyMessage msg, CustomPayloadEvent.Context ctx) {
        ServerPlayer sender = ctx.getSender();
        if (sender != null) {
            // 这里已在主线程（consumerMainThread），可以直接动世界/实体
            ExampleMod.LOGGER.info("got {} from {}", msg.value, sender.getName().getString());
        }
        ctx.setPacketHandled(true);
    }

    public static void sendToServer(MyMessage msg) {
        CHANNEL.send(msg, net.minecraftforge.network.PacketDistributor.SERVER.noArg());
    }

    public static void sendToPlayer(ServerPlayer player, MyMessage msg) {
        CHANNEL.send(msg, net.minecraftforge.network.PacketDistributor.PLAYER.with(player));
    }

    public static void broadcast(MyMessage msg) {
        CHANNEL.send(msg, net.minecraftforge.network.PacketDistributor.ALL.noArg());
    }
}
```

## 示例：客户端发送

```java
// 在客户端代码中（玩家输入等触发）
ModNetwork.sendToServer(new MyMessage(1, new ResourceLocation(ExampleMod.MOD_ID, "demo")));
```

