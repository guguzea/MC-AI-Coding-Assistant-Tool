    }
}
```

## 示例：KeyBinding 处理

```java
// keys/ModKeys.java
@SideOnly(Side.CLIENT)
public class ModKeys {
    public static KeyBinding KEY_TEST;

    public static void init() {
        KEY_TEST = new KeyBinding("key.examplemod.test",
                Keyboard.KEY_G, "key.categories.examplemod");
        ClientRegistry.registerKeyBinding(KEY_TEST);
    }
}
```

```java
// ClientProxy.java
@SideOnly(Side.CLIENT)
public class ClientProxy extends CommonProxy {
    @Override
    public void init(FMLInitializationEvent event) {
        super.init(event);
        ModKeys.init();
        MinecraftForge.EVENT_BUS.register(new KeyInputHandler());
    }
}
```

```java
// keys/KeyInputHandler.java
@SideOnly(Side.CLIENT)
public class KeyInputHandler {
    @SubscribeEvent
    public void onKeyInput(InputEvent.KeyInputEvent event) {
        if (ModKeys.KEY_TEST.isPressed()) {
            // 按键按下时的逻辑
        }
    }
}
```

## 示例：服务端数据同步

```java
// TileEntity 中的同步
public class TileEntityExample extends TileEntity {
    private int syncData = 0;

    @Override
    public SPacketUpdateTileEntity getUpdatePacket() {
        NBTTagCompound nbt = new NBTTagCompound();
        nbt.setInteger("syncData", syncData);
        return new SPacketUpdateTileEntity(pos, 1, nbt);
    }

    @Override
    public void onDataPacket(NetworkManager net, SPacketUpdateTileEntity pkt) {
        syncData = pkt.getNbtCompound().getInteger("syncData");
    }

    @Override
    public NBTTagCompound getUpdateTag() {
        NBTTagCompound nbt = super.getUpdateTag();
        nbt.setInteger("syncData", syncData);
        return nbt;
    }
}
```

> 注意：
> - 1.12.2 的 TileEntity 同步使用 `getUpdatePacket()` / `onDataPacket()`
> - `markDirty()` 标记数据已修改
> - `world.notifyBlockUpdate()` 将更新通知发送给客户端
